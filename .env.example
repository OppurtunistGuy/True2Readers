# Copy to .env (local) and set the same names in Vercel > Project > Settings > Environment Variables.
# Never commit the real values.

# Prisma / SQLite connection string, e.g. file:./db/custom.db
DATABASE_URL="file:./db/custom.db"

# Signs login sessions. REQUIRED in production (>= 32 random characters); without it
# sign-in is refused. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=""
